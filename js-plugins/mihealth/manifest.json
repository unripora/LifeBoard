{
  "id": "com.lifeboard.plugin.mihealth",
  "name": "小米运动健康",
  "version": "1.7.1",
  "versionCode": 28,
  "apiVersion": 4,
  "entry": "main.js",
  "description": "从小米运动健康云端拉取步数、距离、热量、睡眠（含深睡/效率/清醒次数/规律性）、心率、静息心率、血氧、压力与等级、体重与全部身体成分、训练负荷、能量、耳机噪声、每日目标达成等指标",
  "author": "LifeBoard",
  "defaultTabName": "健康",

  "metrics": [
    { "metricKey": "STEPS", "bucket": "STEPS", "displayName": "步数", "aggregate": "sum" },
    { "metricKey": "OBS_DISTANCE", "bucket": "COUNT", "displayName": "距离", "unit": "米", "aggregate": "sum" },
    { "metricKey": "OBS_CALORIES", "bucket": "COUNT", "displayName": "热量", "unit": "kcal", "aggregate": "sum" },

    { "metricKey": "SLEEP_MINUTES", "bucket": "SLEEP_MINUTES", "displayName": "睡眠总时长", "aggregate": "sum" },
    { "metricKey": "SLEEP_DEEP_RATIO", "bucket": "COUNT", "displayName": "深睡占比", "unit": "%", "aggregate": "latest" },
    { "metricKey": "SLEEP_EFFICIENCY", "bucket": "COUNT", "displayName": "睡眠效率", "unit": "%", "aggregate": "latest" },
    { "metricKey": "SLEEP_AWAKE_COUNT", "bucket": "COUNT", "displayName": "清醒次数", "unit": "次", "aggregate": "sum" },
    { "metricKey": "SLEEP_BEDTIME", "bucket": "COUNT", "displayName": "入睡时间", "unit": "分钟", "aggregate": "latest" },
    { "metricKey": "SLEEP_REGULARITY", "bucket": "COUNT", "displayName": "入睡规律性", "unit": "分", "aggregate": "latest" },

    { "metricKey": "OBS_HEART_RATE", "bucket": "COUNT", "displayName": "心率", "unit": "bpm", "aggregate": "average" },
    { "metricKey": "OBS_RESTING_HEART_RATE", "bucket": "COUNT", "displayName": "静息心率", "unit": "bpm", "aggregate": "latest" },
    { "metricKey": "OBS_SPO2", "bucket": "COUNT", "displayName": "血氧", "unit": "%", "aggregate": "average" },
    { "metricKey": "OBS_STRESS", "bucket": "COUNT", "displayName": "压力", "unit": "", "aggregate": "average" },
    { "metricKey": "OBS_STRESS_GRADE", "bucket": "COUNT", "displayName": "压力等级", "unit": "", "aggregate": "latest" },

    { "metricKey": "OBS_WEIGHT", "bucket": "COUNT", "displayName": "体重", "unit": "kg", "aggregate": "latest" },
    { "metricKey": "OBS_BMI", "bucket": "COUNT", "displayName": "BMI", "unit": "", "aggregate": "latest" },
    { "metricKey": "OBS_BODY_FAT_RATE", "bucket": "COUNT", "displayName": "体脂率", "unit": "%", "aggregate": "latest" },
    { "metricKey": "OBS_MUSCLE_RATE", "bucket": "COUNT", "displayName": "肌肉率", "unit": "%", "aggregate": "latest" },
    { "metricKey": "OBS_MOISTURE_RATE", "bucket": "COUNT", "displayName": "水分率", "unit": "%", "aggregate": "latest" },
    { "metricKey": "OBS_BONE_MASS", "bucket": "COUNT", "displayName": "骨量", "unit": "kg", "aggregate": "latest" },
    { "metricKey": "OBS_BASAL_METABOLISM", "bucket": "COUNT", "displayName": "基础代谢", "unit": "kcal", "aggregate": "latest" },
    { "metricKey": "OBS_PROTEIN_RATE", "bucket": "COUNT", "displayName": "蛋白质率", "unit": "%", "aggregate": "latest" },
    { "metricKey": "OBS_VISCERAL_FAT", "bucket": "COUNT", "displayName": "内脏脂肪", "unit": "级", "aggregate": "latest" },
    { "metricKey": "OBS_MUSCLE_MASS", "bucket": "COUNT", "displayName": "肌肉量", "unit": "kg", "aggregate": "latest" },
    { "metricKey": "OBS_PROTEIN_MASS", "bucket": "COUNT", "displayName": "蛋白质量", "unit": "kg", "aggregate": "latest" },
    { "metricKey": "OBS_BODY_MOISTURE_MASS", "bucket": "COUNT", "displayName": "体水分量", "unit": "kg", "aggregate": "latest" },
    { "metricKey": "OBS_SKELETAL_MUSCLE_MASS", "bucket": "COUNT", "displayName": "骨骼肌量", "unit": "kg", "aggregate": "latest" },
    { "metricKey": "OBS_BODY_AGE", "bucket": "COUNT", "displayName": "身体年龄", "unit": "岁", "aggregate": "latest" },
    { "metricKey": "OBS_BODY_SCORE", "bucket": "COUNT", "displayName": "身体得分", "unit": "分", "aggregate": "latest" },

    { "metricKey": "OBS_TRAINING_LOAD", "bucket": "COUNT", "displayName": "训练负荷", "unit": "", "aggregate": "latest" },
    { "metricKey": "OBS_TRAINING_LEVEL", "bucket": "COUNT", "displayName": "训练负荷等级", "unit": "级", "aggregate": "latest" },

    { "metricKey": "OBS_STAND", "bucket": "COUNT", "displayName": "站立", "unit": "次", "aggregate": "sum" },
    { "metricKey": "OBS_STAND_DURATION", "bucket": "DURATION_MINUTES", "displayName": "站立时长", "aggregate": "sum" },
    { "metricKey": "OBS_INTENSITY", "bucket": "COUNT", "displayName": "中高强度活动", "unit": "分钟", "aggregate": "sum" },
    { "metricKey": "OBS_ENERGY", "bucket": "COUNT", "displayName": "能量", "unit": "", "aggregate": "latest" },
    { "metricKey": "OBS_HEADSET_NOISE", "bucket": "COUNT", "displayName": "耳机噪声", "unit": "dB", "aggregate": "average" },
    { "metricKey": "OBS_MENSTRUATION", "bucket": "FLAG", "displayName": "经期记录", "unit": "天", "aggregate": "sum" },
    { "metricKey": "OBS_VO2_MAX", "bucket": "COUNT", "displayName": "VO2Max", "unit": "ml/kg/min", "aggregate": "latest" },
    { "metricKey": "OBS_PAI", "bucket": "COUNT", "displayName": "PAI", "unit": "", "aggregate": "latest" },
    { "metricKey": "OBS_BLOOD_SYSTOLIC", "bucket": "COUNT", "displayName": "收缩压", "unit": "mmHg", "aggregate": "latest" },
    { "metricKey": "OBS_BLOOD_DIASTOLIC", "bucket": "COUNT", "displayName": "舒张压", "unit": "mmHg", "aggregate": "latest" },
    { "metricKey": "OBS_BLOOD_SUGAR", "bucket": "COUNT", "displayName": "血糖", "unit": "mmol/L", "aggregate": "latest" },

    { "metricKey": "GOAL_STEPS", "bucket": "STEPS", "displayName": "步数目标达成", "aggregate": "latest" },
    { "metricKey": "GOAL_CALORIES", "bucket": "COUNT", "displayName": "热量目标达成", "unit": "kcal", "aggregate": "latest" },
    { "metricKey": "GOAL_ACTIVE_MINUTES", "bucket": "DURATION_MINUTES", "displayName": "活动目标达成", "aggregate": "latest" },
    { "metricKey": "GOAL_STAND_HOURS", "bucket": "COUNT", "displayName": "站立目标达成", "unit": "小时", "aggregate": "latest" }
  ],

  "credentialSpec": [
    {
      "name": "account",
      "displayName": "小米账号",
      "required": true,
      "secret": false
    },
    {
      "name": "password",
      "displayName": "密码",
      "required": true,
      "secret": true
    }
  ]
}
