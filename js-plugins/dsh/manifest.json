{
  "id": "com.lifeboard.plugin.dsh",
  "name": "DSH 远程对话",
  "version": "2.2.0",
  "versionCode": 35,
  "apiVersion": 5,
  "entry": "main.js",
  "lifecycle": "onDemand",
  "description": "通过局域网直连电脑上的 DeepSeek Harness，在插件详情页里对话。使用 dsh-mobile 网关的私有 CA 钉扎与设备配对，不经过任何公网中转。",
  "author": "LifeBoard",
  "defaultTabName": "对话",

  "pinnedCaSha256": "runtime",

  "metrics": [
    { "metricKey": "TURN_DONE", "bucket": "COUNT", "displayName": "完成轮次", "unit": "轮", "aggregate": "sum" },
    { "metricKey": "TURN_INTERRUPTED", "bucket": "COUNT", "displayName": "中断轮次", "unit": "轮", "aggregate": "sum" },
    { "metricKey": "TURN_FAILED", "bucket": "COUNT", "displayName": "失败轮次", "unit": "轮", "aggregate": "sum" }
  ],

  "credentialSpec": [
    {
      "name": "gateway-pairing",
      "displayName": "网关配对",
      "required": false,
      "secret": true
    }
  ]
}
