{
  "name": "lifeboard-js-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "LifeBoard JS 插件的类型定义与构建链",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:mihealth && npm run verify:mihealth",
    "build:mihealth": "esbuild mihealth/main.ts --bundle --format=esm --target=es2020 --outfile=mihealth/main.js --log-level=warning",
    "verify:mihealth": "node scripts/verify-bundle.mjs mihealth/main.js",
    "package:mihealth": "node scripts/package-plugin.mjs mihealth"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
