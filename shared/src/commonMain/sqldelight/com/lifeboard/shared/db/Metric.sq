-- 原始指标表。按 源 + 日期 + 分桶 聚合，全年粒度设计以便后续做年度总结时不改库。
CREATE TABLE `metric` (
    `sourceType` TEXT NOT NULL,
    `date` TEXT NOT NULL,
    `bucket` TEXT NOT NULL,
    `value` REAL NOT NULL,
    PRIMARY KEY(`sourceType`, `date`, `bucket`)
);

CREATE INDEX IF NOT EXISTS `index_metric_date` ON `metric` (`date`);

-- 插件指标的元数据（每源一条）。
--
-- 插件的指标是运行时装配的，宿主编译期不知道有哪些，此前这份元数据
-- （MetricSpec 的 displayName / bucket / unit）只活在内存里，一重启就丢，
-- 读取侧只能靠 key 猜：displayName 拼成 "<pluginId>·STEPS"，
-- bucket 反解不出就退化成 COUNT，心率被标成「次」。
--
-- 与 `metric` 分表的理由见 migrations/18.sqm：不碰已有主键、不迁移历史行，
-- 且 meta 是低频数据，混进按天增长的 metric 只会重复膨胀。
CREATE TABLE `metric_meta` (
    `sourceType` TEXT NOT NULL,
    `pluginId` TEXT NOT NULL,
    `metricKey` TEXT NOT NULL,
    `displayName` TEXT NOT NULL,
    `unit` TEXT NOT NULL,
    `bucket` TEXT NOT NULL,
    `updatedAt` INTEGER NOT NULL,
    PRIMARY KEY(`sourceType`)
);

CREATE INDEX IF NOT EXISTS `index_metric_meta_pluginId` ON `metric_meta` (`pluginId`);

-- 数据源健康度表，面板据此提示断源降级。
CREATE TABLE `source_health` (
    `sourceType` TEXT NOT NULL,
    `healthy` INTEGER NOT NULL,
    `lastSuccessAt` INTEGER NOT NULL,
    `message` TEXT NOT NULL,
    PRIMARY KEY(`sourceType`)
);

-- 分应用屏幕使用时长。
--
-- 为什么单独一张表：metric 的主键是 (sourceType, date, bucket)，没有应用这个维度，
-- 而「屏幕使用总时长」与「各应用各用多久」是两种粒度，塞进同一张表会破坏主键语义。
-- 这里用 (date, packageName) 做主键，同一天同一应用重复采集直接覆盖，天然幂等。
CREATE TABLE `app_usage` (
    `date` TEXT NOT NULL,
    `packageName` TEXT NOT NULL,
    `minutes` REAL NOT NULL,
    `label` TEXT NOT NULL,
    PRIMARY KEY(`date`, `packageName`)
);

-- ============ 查询 ============

selectMetricsByDate:
SELECT * FROM `metric` WHERE `date` = ?;

selectMetric:
SELECT * FROM `metric` WHERE `sourceType` = ? AND `date` = ? AND `bucket` = ?;

selectMetricsInRange:
SELECT * FROM `metric` WHERE `date` BETWEEN ? AND ? ORDER BY `date` ASC;

-- 一次取整窗数据，而不是逐天调用：30 天 × 3 条序列 = 90 次往返，这里只要 3 次。
-- 缺失的日期不会出现在结果里，补不补零由图表层决定
selectSourceRange:
SELECT * FROM `metric`
WHERE `sourceType` = ? AND `bucket` = ? AND `date` BETWEEN ? AND ?
ORDER BY `date` ASC;

-- 往前找「最近一次」的值。必须在 SQL 里做：逐天把日期字符串减一天，跨月会出错。
-- 按 bucket 而不是整个源过滤：一个源同时有步数与睡眠时，
-- 读「睡眠」卡不该拿到只有步数的日期
latestDateWithBucket:
SELECT MAX(`date`) AS latestDate FROM `metric`
WHERE `sourceType` = ? AND `bucket` = ? AND `date` BETWEEN ? AND ?;

insertMetric:
INSERT OR REPLACE INTO `metric`(`sourceType`, `date`, `bucket`, `value`) VALUES (?, ?, ?, ?);

deleteMetricsBySource:
DELETE FROM `metric` WHERE `sourceType` = ?;

-- ---- 插件指标元数据 ----

selectMetricMeta:
SELECT * FROM `metric_meta` WHERE `sourceType` = ?;

-- 一次取一组源，避免读取侧逐条查库（面板每帧都可能重建卡片列表）
selectMetricMetaIn:
SELECT * FROM `metric_meta` WHERE `sourceType` IN ?;

selectMetricMetaByPlugin:
SELECT * FROM `metric_meta` WHERE `pluginId` = ? ORDER BY `metricKey` ASC;

-- REPLACE 而不是 INSERT：插件重装或指标改名时同名源要直接覆盖。
-- 用 INSERT 会在主键冲突时抛异常，表现为「插件升级后采集直接报错」
insertMetricMeta:
INSERT OR REPLACE INTO `metric_meta`(
    `sourceType`, `pluginId`, `metricKey`, `displayName`, `unit`, `bucket`, `updatedAt`
) VALUES (?, ?, ?, ?, ?, ?, ?);

-- 插件卸载时按 pluginId 清干净；只删 meta，不动 metric 里的历史值，
-- 因为用户可能只是想重装插件，历史数据不该跟着消失
deleteMetricMetaByPlugin:
DELETE FROM `metric_meta` WHERE `pluginId` = ?;

-- ---- 数据源健康度 ----

observeSourceHealth:
SELECT * FROM `source_health`;

selectAllSourceHealth:
SELECT * FROM `source_health`;

insertSourceHealth:
INSERT OR REPLACE INTO `source_health`(`sourceType`, `healthy`, `lastSuccessAt`, `message`)
VALUES (?, ?, ?, ?);

deleteSourceHealthBySource:
DELETE FROM `source_health` WHERE `sourceType` = ?;

-- ---- 分应用用量 ----

observeAppUsageByDate:
SELECT * FROM `app_usage` WHERE `date` = ? ORDER BY `minutes` DESC;

selectAppUsageByDate:
SELECT * FROM `app_usage` WHERE `date` = ? ORDER BY `minutes` DESC;

insertAppUsage:
INSERT OR REPLACE INTO `app_usage`(`date`, `packageName`, `minutes`, `label`)
VALUES (?, ?, ?, ?);

deleteAppUsageByDate:
DELETE FROM `app_usage` WHERE `date` = ?;

trimAppUsageBefore:
DELETE FROM `app_usage` WHERE `date` < ?;

-- 在 SQL 里按包名聚合，避免把整段区间的原始行拉进内存再分组。
-- label 取 MAX 而不是任意值：同一应用在不同日期可能有空串，
-- MAX 能稳定挑到非空的那个（空串字典序最小）
sumAppUsageInRange:
SELECT `packageName` AS packageName,
       MAX(`label`) AS label,
       SUM(`minutes`) AS minutes
FROM `app_usage`
WHERE `date` BETWEEN ? AND ?
GROUP BY `packageName`
ORDER BY minutes DESC;
