-- 插件凭据表。
--
-- 落库的是**密文**（见 CredentialVault）：cipherText 是 Keystore 加密后的
-- IV + GCM 密文，直接拷走数据库文件解不出明文。
--
-- 隔离靠 pluginId 命名空间 + 接口层绑定：插件拿到的 CredentialStore
-- 在构造时就写死了自己的 pluginId，越权在类型层面不可表达。
CREATE TABLE `plugin_credential` (
    `pluginId` TEXT NOT NULL,
    `slot` TEXT NOT NULL,
    `cipherText` TEXT NOT NULL,
    `updatedAt` INTEGER NOT NULL,
    PRIMARY KEY(`pluginId`, `slot`)
);

CREATE INDEX IF NOT EXISTS `index_plugin_credential_pluginId` ON `plugin_credential` (`pluginId`);

-- 插件上报的原始条目（「上次同步的快照」）。
--
-- 为什么不塞进 metric：metric 一天一条聚合值，原始条目一天可能几十上百条，
-- 塞进去会破坏主键语义，也会污染所有按天聚合的查询。
-- 这些条目**只用于展示**：不参与判定、不参与计分、不进趋势图。
--
-- 按 (pluginId, date, metricKey) 整体替换：同一天同一指标再同步就覆盖，
-- 不同日期各存各的——历史回补拉回来的旧日期也能留下来。
CREATE TABLE `plugin_raw_record` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `pluginId` TEXT NOT NULL,
    `date` TEXT NOT NULL,
    `metricKey` TEXT NOT NULL,
    `timestamp` INTEGER NOT NULL,
    `value` REAL NOT NULL,
    `detail` TEXT NOT NULL,
    `seq` INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS `index_plugin_raw_record_pluginId_date`
    ON `plugin_raw_record` (`pluginId`, `date`);
CREATE INDEX IF NOT EXISTS `index_plugin_raw_record_pluginId_date_metricKey`
    ON `plugin_raw_record` (`pluginId`, `date`, `metricKey`);

-- 记录「某个插件的某个指标在某天被查询过」。
--
-- 要解决的问题：插件查了某指标但一条没拿到时，详情页应显示「暂无」，
-- 而不是让这个指标凭空消失。光靠 plugin_raw_record 分不清
-- 「没查过」和「查了但为空」——两种情况下那张表都没有行。
--
-- 若改在主表插空行，则每个读主表的地方都要过滤掉这些假条目，
-- 漏一处就会在列表里看到一行 value = 0 的幽灵数据。
CREATE TABLE `plugin_metric_query` (
    `pluginId` TEXT NOT NULL,
    `date` TEXT NOT NULL,
    `metricKey` TEXT NOT NULL,
    PRIMARY KEY(`pluginId`, `date`, `metricKey`)
);

CREATE INDEX IF NOT EXISTS `index_plugin_metric_query_pluginId_date`
    ON `plugin_metric_query` (`pluginId`, `date`);

-- ============ 凭据查询 ============

selectCredential:
SELECT `cipherText` FROM `plugin_credential` WHERE `pluginId` = ? AND `slot` = ?;

selectCredentialSlots:
SELECT `slot` FROM `plugin_credential` WHERE `pluginId` = ? ORDER BY `slot` ASC;

insertCredential:
INSERT OR REPLACE INTO `plugin_credential`(`pluginId`, `slot`, `cipherText`, `updatedAt`)
VALUES (?, ?, ?, ?);

deleteCredentialsByPlugin:
DELETE FROM `plugin_credential` WHERE `pluginId` = ?;

deleteCredentialSlot:
DELETE FROM `plugin_credential` WHERE `pluginId` = ? AND `slot` = ?;

-- ============ 原始条目查询 ============

-- 排序用 (date DESC, metricKey ASC, seq ASC, id ASC) 而不是 timestamp：
-- 同一秒可能有多条采样点，光按时间排会让每次展示的顺序都不稳定
selectRawRecordsInRange:
SELECT * FROM `plugin_raw_record`
WHERE `pluginId` = ? AND `date` BETWEEN ? AND ?
ORDER BY `date` DESC, `metricKey` ASC, `seq` ASC, `id` ASC;

selectEarliestRawRecordDate:
SELECT MIN(`date`) FROM `plugin_raw_record` WHERE `pluginId` = ?;

selectLatestRawRecordDate:
SELECT MAX(`date`) FROM `plugin_raw_record` WHERE `pluginId` = ?;

insertRawRecord:
INSERT INTO `plugin_raw_record`(
    `pluginId`, `date`, `metricKey`, `timestamp`, `value`, `detail`, `seq`
) VALUES (?, ?, ?, ?, ?, ?, ?);

-- 必须带 metricKey：只按天清会让「这天只有步数」的同步顺手删掉库里已有的睡眠条目，
-- 表现为「同步一次原始数据反而变少了」
deleteRawRecordsByDateAndMetric:
DELETE FROM `plugin_raw_record`
WHERE `pluginId` = ? AND `date` = ? AND `metricKey` = ?;

clearAllRawRecords:
DELETE FROM `plugin_raw_record`;

-- ============ 查询痕迹 ============

-- 用 REPLACE：同一天重复查询同一指标不该报主键冲突
insertMetricQuery:
INSERT OR REPLACE INTO `plugin_metric_query`(`pluginId`, `date`, `metricKey`)
VALUES (?, ?, ?);

selectMetricQueriesInRange:
SELECT DISTINCT `metricKey` FROM `plugin_metric_query`
WHERE `pluginId` = ? AND `date` BETWEEN ? AND ?;

selectEarliestMetricQueryDate:
SELECT MIN(`date`) FROM `plugin_metric_query` WHERE `pluginId` = ?;

clearAllMetricQueries:
DELETE FROM `plugin_metric_query`;
